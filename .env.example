# App settings
APP_NAME=Lenny Growth Assistant
APP_ENV=development

# Local database mode
# PostgreSQL is the default for local development. Replace the placeholder with the
# password created for the dedicated lenny_growth_app role; do not commit .env.
DATABASE_URL=postgresql+psycopg2://lenny_growth_app:replace_me@127.0.0.1:5432/lenny_growth
USE_SQLITE_FALLBACK=false

# SQLite remains available for isolated tests and quick demos:
# DATABASE_URL=sqlite:///./lenny_growth_demo.db
# USE_SQLITE_FALLBACK=true

# Model providers
# Local Ollama is the default provider for this app. If it is unavailable, the app returns a clear local-setup error.
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
CLAUDE_AGENT_API_KEY=

# Artifact safety
ARTIFACT_ALLOWED_TAGS=div,p,h1,h2,h3,h4,h5,h6,span,strong,b,em,i,ul,ol,li,blockquote,code,pre,hr,table,thead,tbody,tr,th,td,a,br
ARTIFACT_ALLOWED_ATTRIBUTES=a[href],img[src],img[alt]

# Optional demo tuning
MAX_RETRIEVAL_CHUNKS=4
